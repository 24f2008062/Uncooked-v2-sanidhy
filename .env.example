# See docs/ENV.md for the full contract. Never commit real secrets.

# --- Required URLs & Canonical Host ---
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Required Security Secrets (min 32 chars, distinct from each other) ---
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NEXTAUTH_SECRET=
TICKET_HMAC_SECRET=

# --- Required Database (PostgreSQL / Supabase) ---
# For local Postgres: postgresql://postgres:postgres@localhost:5432/opportia_db?schema=public
# For Supabase Pooler (Transaction Mode port 6543):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportia_db?schema=public
# Direct/Session URL (Port 5432) used for Prisma migrations and schema push:
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/opportia_db?schema=public
# Set false if connecting to Supabase pooler without local custom CA certificates:
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=3
# CRITICAL: NEVER set NODE_TLS_REJECT_UNAUTHORIZED=0.

# --- Supabase Authentication & Client ---
# Project URL and API keys from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (Required for Production Rate Limiting & Health) ---
# Free tier Upstash Redis REST credentials from console.upstash.com
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring & Error Reporting ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# --- Product Gates ---
# VERIFIED_HOSTS_ONLY=true

# --- Legal / DPDP Compliance ---
LEGAL_ENTITY_NAME=Opportia
GRIEVANCE_OFFICER_NAME=Grievance Officer
GRIEVANCE_EMAIL=support@opportia.in
SUPPORT_EMAIL=support@opportia.in
# PRIVACY_CONTACT_EMAIL=privacy@opportia.in

# --- Optional OAuth & Email Providers ---
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=Opportia <support@opportia.in>

# --- Optional SMTP Configuration ---
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@opportia.in
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Opportia <support@opportia.in>
